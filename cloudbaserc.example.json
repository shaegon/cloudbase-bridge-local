{
  "$schema": "https://framework-1258016615.tcloudbaseapp.com/cloudbase-rc-5000.json",
  "envId": "YOUR-ENV-ID",
  "functionRoot": "./cloudfunctions",
  "functions": [
    {
      "name": "aiProxy",
      "timeout": 120,
      "memorySize": 256,
      "runtime": "Nodejs18.15",
      "installDependency": true,
      "envVariables": {
        "AI_PROXY_ALLOWED_MODELS": "hy4-flash,hy4,hy4-preview,hy3,deepseek-v4.1-flash,deepseek-v4.1-flash-1017",
        "AI_PROXY_ALLOW_REMOTE_IMAGES": "false"
      },
      "triggers": []
    }
  ]
}
